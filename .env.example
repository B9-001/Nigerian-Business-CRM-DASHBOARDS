# =============================================================================
# Nigerian Business Operating System — environment configuration
# Copy to .env.local for local dev. NEVER commit real secrets.
# Anything without NEXT_PUBLIC_ stays server-only and must never be exposed
# to client bundles or browser code.
# =============================================================================

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Credential encryption (AES-256-GCM key for integration_credentials) ---
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- AI Providers ------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_PROVIDER=google

# --- Google Workspace / Google Meet OAuth ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Zoom OAuth --------------------------------------------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/api/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Redis / Queue (BullMQ) --------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5
QUEUE_PREFIX=nbos

# --- Outbound automation (n8n) ------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Outgoing webhook signing -----------------------------------------------
WEBHOOK_SIGNING_SECRET=

# --- Email -------------------------------------------------------------------
EMAIL_FROM=notifications@yourdomain.com
RESEND_API_KEY=
SMTP_URL=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
SLOW_REQUEST_THRESHOLD_MS=1000

# --- Rate limiting (Upstash Redis REST, optional alt to REDIS_URL) --------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Localization defaults ---------------------------------------------------
NEXT_PUBLIC_DEFAULT_CURRENCY=NGN
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Lagos
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+234
